---
/**
 * Renders one tool with its page defaults: `repay` (props: operator, ticket, price, delay, lock) or
 * `mini:<spec>` from `lib/mini-specs.ts`.
 */
import RepayCalc from './calc/RepayCalc';
import MiniSim from './calc/MiniSim';
import { route, hasRoute, type Locale } from '../i18n/routes';
import { getSpec, opIndexOf } from '../lib/mini-specs';
import type { ToolDef } from '../lib/guide-types';
interface Props { tool: ToolDef; lang?: Locale; primary?: boolean; idPrefix?: string; seedKey?: string }
const { tool, lang = 'en', primary = false, idPrefix } = Astro.props;
const props = (tool.props ?? {}) as Record<string, any>;
const kind = tool.kind;
const mini = kind.startsWith('mini:') ? kind.slice(5) : null;
const spec = mini ? getSpec(mini) : null;
const href = spec?.ctaPage && hasRoute(spec.ctaPage, lang) ? route(spec.ctaPage, lang) : spec?.ctaPage === 'home' ? route('home', lang) : undefined;
const numDefaults: Record<string, number> = {};
for (const [k, v] of Object.entries(props)) { if (typeof v === 'number') numDefaults[k] = v; else if (k === 'op' && typeof v === 'string') numDefaults.op = opIndexOf(v); }
---
{kind === 'repay' && <RepayCalc client:load idPrefix={idPrefix ?? (primary ? 'dr' : 'dr2')} operator={props.operator ?? 'avanti-west-coast'} ticket={props.ticket ?? 'single'} price={props.price ?? 60} delay={props.delay ?? 35} lockOperator={!!props.lock} primary={primary} methodHref={route('method', lang)} />}
{mini && <MiniSim client:load kind={mini} href={href} defaults={numDefaults} primary={primary} idPrefix={idPrefix ?? (primary ? 'p' : 'm')} />}
