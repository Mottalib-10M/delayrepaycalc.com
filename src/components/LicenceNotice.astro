---
/** Attributions required by the licences (RECETTE §12.1, rule 3). Shown at the foot of every page, embeds included. */
interface Props { class?: string }
const { class: cls = 'text-xs text-navy-500' } = Astro.props;
const OGL = 'https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/';
---
<p class={cls} data-licence-notice>
  Contains public sector information licensed under the <a class="underline" href={OGL} target="_blank" rel="noopener">Open Government Licence v3.0</a>: delay compensation claims statistics (Table 4410) from the Office of Rail and Road, and bank holiday dates and news from GOV.UK; adapted and calculated by Radif Partners.
  Operator schemes, the National Rail Conditions of Travel and railcard terms are summarised in our own words; no charter or condition is reproduced.
</p>
